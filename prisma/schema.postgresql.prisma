generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth ──

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String   @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Existing Atlas models ──

model AtlasUser {
  id        String   @id @default(cuid())
  clerkId    String   @unique
  email      String?
  name       String?
  createdAt  DateTime @default(now())
}

/// Consumer profile: identity, addresses, payment methods, privacy toggles.
model UserProfile {
  id            String   @id @default(cuid())
  /// Clerk user id, or "atlas-demo-user" for local/guest.
  userId        String   @unique
  name          String   @default("")
  phone         String   @default("")
  email         String   @default("")
  /// JSON: [{ id, label, line }]
  addressesJson String   @default("[]")
  /// JSON: [{ id, kind: "upi"|"card", label, value }] — UPI VPA or card last4+brand only.
  paymentsJson  String   @default("[]")
  /// JSON privacy toggles.
  privacyJson   String   @default("{}")
  /// Per-user live voice replies preference (Profile → Voice).
  voiceEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Credential {
  id        String       @id @default(cuid())
  label     String
  provider  String
  apiKey    String
  baseUrl   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  models    ModelConfig[]
}

model ModelConfig {
  id               String     @id
  credentialId     String
  credential       Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  label            String
  enabled          Boolean    @default(true)
  isDefault        Boolean    @default(false)
  fallbackModelIds String     @default("[]")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  routing          RoutingRule[]
}

model RoutingRule {
  id        String   @id @default(cuid())
  domain    String
  modelId   String
  model     ModelConfig @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Domain {
  id        String   @id @default(cuid())
  slug      String   @unique
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VoiceConfig {
  id          Int      @id @default(1)
  sttLanguage String   @default("en-US")
  ttsVoiceURI String   @default("")
  ttsRate     Float    @default(1)
  ttsPitch    Float    @default(1)
  /// ModelConfig.id used for speech-to-text (Whisper / omni / etc.).
  sttModelId  String   @default("")
  /// Model id or virtual target for TTS (e.g. "local:piper").
  ttsModelId  String   @default("local:piper")
  /// native_first | server_first | native_only | server_only
  sttMode     String   @default("native_first")
  /// server_first | native_first | native_only | server_only
  ttsMode     String   @default("server_first")
  /// Daily voice (STT/TTS) usage cap in minutes per non-admin/non-dev user. 0 = no cap.
  dailyVoiceLimitMinutes Int @default(15)
}

/// Per-user daily voice usage for enforcing the non-admin voice cap.
model VoiceUsage {
  id        String   @id @default(cuid())
  /// better-auth user id or guest id, matched to the voice actor.
  userId    String
  /// Local calendar day (YYYY-MM-DD) the usage belongs to.
  day       String
  /// Accumulated seconds of voice activity on that day.
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId])
}

model Approval {
  id          String    @id
  /// Actor id (better-auth user id or guest id, null for legacy guests). No AtlasUser FK until identity stabilizes.
  userId      String?
  domain      String
  title       String
  summary     String
  fields      String
  status      String    @default("pending")
  reference   String?
  /// Arbitrary JSON for domain-specific execution state, e.g. Swiggy UPI
  /// handoff (orderId, paasId, cartId, lat, lng, upiLink, upiQr, paymentRef).
  meta        String?
  risk        String    @default("standard")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Conversation {
  id           String    @id @default(cuid())
  /// Actor id (better-auth user id or per-visitor guest id). No AtlasUser FK until identity stabilizes.
  userId       String?
  /// Rolling summary of older turns so the model keeps context without full history.
  summary      String    @default("")
  lastMessageAt DateTime @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@index([userId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// Optional JSON metadata (tools used, runId, etc.).
  meta           String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// Durable workflow state (food ordering sessions, tool run state, etc.).
model WorkflowSession {
  id        String   @id
  kind      String
  userId    String?
  payload   String
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([kind, userId])
  @@index([expiresAt])
}

/// Per-turn observability for latency, tokens, tools, and stage timing.
model TurnTrace {
  id             String   @id @default(cuid())
  runId          String   @unique
  conversationId String?
  userId         String?
  domain         String?
  modelId        String?
  stages         String   @default("[]")
  toolsUsed      String   @default("[]")
  tokensIn       Int?
  tokensOut      Int?
  success        Boolean  @default(true)
  error          String?
  totalMs        Int?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Per-LLM-call observability for the live chat pipeline.
model LlmLog {
  id             String   @id @default(cuid())
  runId          String?
  conversationId String?
  userId         String?
  domain         String?
  modelId        String?
  provider       String?
  round          Int      @default(0)
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  success        Boolean  @default(true)
  error          String?
  toolCalls      String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([createdAt])
}

model ActivityItem {
  id        String   @id @default(cuid())
  userId    String?
  time      String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model McpServer {
  id          String   @id @default(cuid())
  name        String
  url         String?
  token       String?
  command     String
  args        String   @default("")
  env         String   @default("")
  domain      String   @default("shopping")
  /// JSON array of inferred roles, e.g. ["agent", "knowledge"].
  roles       String   @default("[]")
  /// JSON object mapping tool name -> tool categories.
  toolRoles   String   @default("{}")
  global      Boolean  @default(false)
  enabled     Boolean  @default(true)
  toolCount   Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model McpOAuthClient {
  id         Int      @id @default(1)
  clientId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  // "user" = long-term personal memory, "knowledge" = uploaded documents/KB.
  kind       String   @default("user")
  // Memory type taxonomy (identity, preference, travel, food, ...). See MemoryType.
  type       String   @default("knowledge")
  // One of: active | archived. Archived memories are excluded from retrieval.
  status     String   @default("active")
  text       String
  /// Optional embedding blob (JSON float array). Postgres/pgvector deferred.
  embedding  String?
  // Confidence (0..1) raised by repeated confirmation, lowered by contradictions.
  confidence Float    @default(0.5)
  // Recency/importance signals used by the Memory Service for ranking.
  importance Float    @default(0.5)
  // Number of times this memory has been retrieved/used.
  accessCount Int      @default(0)
  // Null = permanent. Otherwise the memory auto-expires (temporary memories).
  expiresAt  DateTime?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Graph linkage: a memory may be the source of structured entities/relations.
  entities   MemoryEntity[]

  @@index([userId, kind])
  @@index([userId, type, status])
}

model MemoryEntity {
  id       String   @id @default(cuid())
  userId   String
  // Canonical entity name, e.g. "Hyatt", "Seattle", "user" (the user themselves).
  name     String
  // Optional entity type for reasoning, e.g. "hotel", "city", "company", "cuisine".
  kind     String   @default("entity")
  createdAt DateTime @default(now())

  relationsOut MemoryRelation[] @relation("outgoing")
  relationsIn  MemoryRelation[] @relation("incoming")
  memories     Memory[]

  @@unique([userId, name])
  @@index([userId, kind])
}

model MemoryRelation {
  id         String   @id @default(cuid())
  userId     String
  // Subject and object refer to MemoryEntity rows.
  subjectId  String
  objectId   String
  // The predicate, e.g. "prefers", "works_at", "travels_to", "likes", "no_longer_prefers".
  relation   String
  // Strength (0..1) — mirror of confidence; raised by strengthen, lowered by weaken.
  strength   Float    @default(0.5)
  // One of: active | archived. Replaced facts are archived, not deleted.
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject MemoryEntity @relation("outgoing", fields: [subjectId], references: [id], onDelete: Cascade)
  object  MemoryEntity @relation("incoming", fields: [objectId], references: [id], onDelete: Cascade)

  @@index([userId, relation])
  @@index([subjectId])
  @@index([objectId])
}

/// A user routine Atlas can replay (e.g. "order my usual"). Domain-agnostic:
/// the `domain` names the runner to invoke and `payloadJson` holds that
/// domain's directives, so rides/groceries/hotels/appointments reuse the same
/// store without per-domain tables.
model Routine {
  id          String   @id @default(cuid())
  userId      String
  /// Which runner owns this action (must have a registered runner in the
  /// Routine registry — currently "food").
  domain      String
  /// Short label the user would say, e.g. "my usual", "regular ride".
  label       String
  /// Domain-specific spec handed to the runner at replay time.
  payloadJson String   @default("{}")
  status      String   @default("active")
  /// Human-readable summary shown in Profile so a user can see / delete a routine.
  summary     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, domain, status])
  @@unique([userId, domain, label])
}

/// A behavior Signature Atlas has observed to learn routines naturally.
/// Silent tally until confidence crosses a threshold, then a gentle one-time ask.
model RoutineObservation {
  id          String   @id @default(cuid())
  userId      String
  domain      String
  /// Stable fingerprint of the observed behavior (e.g. dish+restaurant), so
  /// the same action tallies up rather than creating duplicates.
  fingerprint String
  /// Human-readable description, e.g. "chicken biryani from Meghana Foods".
  summary     String   @default("")
  /// Times this exact behavior has been observed.
  count       Int      @default(0)
  /// Confidence derived from repetition (0..1). Grows with count.
  confidence  Float    @default(0)
  /// observing | suggested | accepted | declined
  state       String   @default("observing")
  /// True once we've asked the user (so we don't nag).
  askedEver   Boolean  @default(false)
  /// True once the user declined (so we stop asking this signature).
  declinedEver Boolean  @default(false)
  /// Domain-specific payload to build a Routine if the user says yes.
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, domain, fingerprint])
  @@index([userId, domain, state])
}

/// Durable execution that is the interface; this is the unit of work.
model Execution {
  id             String    @id @default(cuid())
  /// Actor id (Clerk id or null for guest). No AtlasUser FK until identity stabilizes.
  userId         String?
  goal           String
  type           String    @default("immediate")
  status         String    @default("planning")
  planJson       String    @default("{}")
  stateJson      String    @default("{}")
  resultsJson    String    @default("[]")
  metadataJson   String    @default("{}")
  conversationId String?
  runId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  events         ExecutionEvent[]

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, updatedAt])
}

model ExecutionEvent {
  id          String   @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  type        String
  payload     String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([executionId, createdAt])
}

// ── Capability Registry ──

model Capability {
  id              String   @id                          // "food", "shopping", "travel", etc.
  name            String                                // "Food Ordering", "Shopping"
  category        String   @default("action")           // flexible metadata: "action" | "communication" | "knowledge" | any
  icon            String?
  description     String?
  requiresApproval Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  integrations    IntegrationCapability[]
  skills          Skill[]
}

// ── Integration Registry ──

model Integration {
  id              String   @id                          // "swiggy", "zomato", "amazon"
  name            String                                // "Swiggy", "Zomato", "Amazon"
  transport       String   @default("mcp")              // "mcp" | "rest" | "sdk" | "graphql"
  transportOrderJson String @default("[]")
  authMethodsJson String   @default("[]")               // JSON: AuthMethod[]
  icon            String?
  description     String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  capacities      IntegrationCapability[]
  configs         IntegrationConfig[]
  connections     UserConnection[]
  sessions        ConnectorSession[]
  jobs            ConnectorJob[]
  audits          ConnectorAudit[]
  skills          Skill[]
}

model IntegrationCapability {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  capabilityId  String
  capability    Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  priority      Int         @default(10)                // lower = preferred

  @@unique([integrationId, capabilityId])
  @@index([capabilityId, priority])
}

model IntegrationConfig {
  id            String      @id                         // same as integrationId for default config
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  label         String?
  baseUrl       String?
  apiKey        String?                                 // encrypted at rest
  oauthToken    String?                                 // encrypted
  oauthRefresh  String?
  enabled       Boolean     @default(true)
  metadataJson  String      @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([integrationId])
}

/// A delivered proactive brief (daily digest etc.) — idempotent per user/trigger/period.
model ProactiveBrief {
  id            String   @id @default(cuid())
  userId        String
  triggerType   String
  period        String
  status        String   @default("delivered")
  title         String
  itemsJson     String   @default("[]")
  synthetic     Boolean  @default(false)
  deliveredAt   DateTime @default(now())
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, triggerType, period])
  @@index([userId, deliveredAt])
}

/// Per-user proactive engine trigger preferences (schedule, enabled).
model ProactiveTrigger {
  id          String   @id @default(cuid())
  userId      String
  triggerType String
  schedule    String   @default("07:00")
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, triggerType])
}

model UserConnection {
  id              String      @id @default(cuid())
  userId          String
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  displayName     String?
  oauthToken      String?
  oauthRefresh    String?
  tokenExpiresAt  DateTime?
  apiKey          String?
  metadataJson    String      @default("{}")
  status          String      @default("active")        // "active" | "expired" | "revoked"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, integrationId])
  @@index([userId, status])
}

model ConnectorSession {
  id            String      @id @default(cuid())
  userId        String
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  stateJson     String      @default("{}")
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, integrationId])
}

model ConnectorJob {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        String      @default("pending")
  payloadJson   String      @default("{}")
  resultJson    String?
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?

  @@index([integrationId, status])
}

model ConnectorAudit {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  userId        String?
  action        String
  resource      String?
  status        String      @default("success")
  detailsJson   String      @default("{}")
  createdAt     DateTime    @default(now())

  @@index([integrationId, createdAt])
}

// ── Unified Capability Registry (Skills, Business Providers) ──

/// A business provider powers connectors and LLM integrations: it is the
/// technical service/endpoint behind a connector (e.g. "Swiggy MCP", "Google
/// Cloud SDK") or a model source. Implementation method is the kind.
model Provider {
  id                  String    @id @default(cuid())
  name                String
  /// "mcp" | "api" | "sdk" | "browser" — implementation method.
  kind                String    @default("mcp")
  baseUrl             String?
  authType            String    @default("api_key") // "api_key" | "oauth2" | "none"
  /// Optional Credential link for an API key that powers this provider.
  credentialId        String?
  endpointCatalogJson String    @default("[]") // discovered endpoints, JSON array
  endpointsDiscoveredAt DateTime?
  source              String    @default("manual") // "catalog" | "discovered" | "manual"
  status              String    @default("active") // "draft" | "active" | "deprecated"
  enabled             Boolean   @default(true)
  lastTestedAt        DateTime?
  lastTestOk          Boolean?
  metadataJson        String    @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  skills              Skill[]
}

/// A skill is a capability Atlas can perform. Skills are offered by
/// connectors and powered by providers; the implementation method
/// (mcp/api/sdk/browser) is recorded on the provider.
model Skill {
  id               String       @id @default(cuid())
  name             String
  category         String       @default("action") // "action" | "communication" | "knowledge" | any
  description      String?
  capabilityId     String
  capability       Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  connectorId      String?
  connector        Integration? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  providerId       String?
  provider         Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  requiresApproval Boolean      @default(true)
  enabled          Boolean      @default(true)
  version          String       @default("1.0.0")
  status           String       @default("draft") // "draft" | "active" | "deprecated"
  /// JSON: recipe / playbook scaffold for the skill (e.g. browser recipe).
  recipeJson       String       @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([capabilityId])
  @@index([connectorId])
}

