# Server-only model configuration. Never expose these values with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
ATLAS_MODEL=gpt-4.1-mini

# Database — SQLite for local/dev while Execution Engine stabilizes.
# Postgres/pgvector migration is paused (see docs/atlas-plan/).
DATABASE_URL="file:./dev.db"

# Better Auth — URL users land on and its session secret. MUST be set in prod.
# BETTER_AUTH_URL=https://your-deployed-origin.run.app
# BETTER_AUTH_SECRET=...
# Comma-separated list of origins allowed to call back (CSRF). Defaults to localhost dev ports.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OAuth — create OAuth client ID (Web application) in Google Cloud Console:
#   Authorized JS origin: http://localhost:3001 (and deployed origin)
#   Authorized redirect URI: http://localhost:3001/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Clerk user authentication. Once configured, live model and MCP actions require a signed-in user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated list of user ids allowed to access /admin and the admin APIs.
# Find your id in the DB (User.id) or from a signed-in session. When unset, admin
# access is denied (no default admin).
ATLAS_ADMIN_USER_IDS=

# Optional server-side MCP gateway. The gateway accepts POST JSON:
# { "tool": "search" | "prepare_approval" | "execute_approved_action", "arguments": { ... } }
# and returns { "message": "...", "data": { ... } }.
ATLAS_MCP_GATEWAY_URL=
ATLAS_MCP_GATEWAY_TOKEN=

# parallel.ai web search MCP (https://search.parallel.ai/mcp).
# When set, Atlas seeds a global web-search tool so the assistant can search the web on any message.
PARALLEL_API_KEY=
PARALLEL_MCP_URL=https://search.parallel.ai/mcp

# Serper.dev web search (https://serper.dev). Optional — preferred over the MCP
# search when set. Can also be configured from the Admin → Search tab.
SERPER_API_KEY=

# NVIDIA API key — used for the NeMo omni voice model (speech-to-text and
# text-to-speech) and any nvidia-hosted chat model. Server-side only.
NVIDIA_API_KEY=
