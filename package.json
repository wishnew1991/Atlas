{
  "name": "image-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/stop-dev.sh; npx prisma generate --no-hints 2>/dev/null; npx prisma migrate deploy; npx tsx scripts/seed-registry.ts; rm -rf .next .turbo",
    "dev": "next dev",
    "dev:clean": "rm -rf .next .turbo && npx prisma migrate deploy && npx tsx scripts/seed-registry.ts && next dev",
    "dev:restart": "bash scripts/dev-restart.sh",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx @cloudflare/next-on-pages --preview",
    "pages:deploy": "npx @cloudflare/next-on-pages && npx wrangler pages deploy",
    "d1:create": "npx wrangler d1 create atlas-db",
    "d1:migrate": "npx wrangler d1 execute atlas-db --file=./prisma/migrations/*/migration.sql",
    "seed:search": "node scripts/seed-search-mcp.mjs",
    "seed:registry": "npx tsx scripts/seed-registry.ts",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:food": "node scripts/test-food-nlu.mjs",
    "test:routines": "node scripts/test-routines.mjs",
    "test:agent": "vitest run --config vitest.config.ts",
    "test:agent:watch": "vitest --config vitest.config.ts",
    "test:agent:report": "vitest run --config vitest.config.ts && npx tsx scripts/test-agent/generate-report.ts",
    "test:behavioral": "npx tsx scripts/behavioral-validation.ts run",
    "test:behavioral:report": "npx tsx scripts/behavioral-validation.ts run --format html --output reports/behavioral.html",
    "test:behavioral:regression": "npx tsx scripts/behavioral-validation.ts batch-regression",
    "test:behavioral:golden": "npx tsx scripts/behavioral-validation.ts create-golden",
    "test:behavioral:golden-list": "npx tsx scripts/behavioral-validation.ts golden-list",
    "test:behavioral:golden-diff": "npx tsx scripts/behavioral-validation.ts golden-diff",
    "test:behavioral:golden-accept": "npx tsx scripts/behavioral-validation.ts golden-accept",
    "test:behavioral:golden-cleanup": "npx tsx scripts/behavioral-validation.ts golden-cleanup",
    "trace:pipeline": "node scripts/trace-pipeline.mjs",
    "trace:food": "node scripts/trace-food.mjs"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20240208.0",
    "@noble/hashes": "2.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.20.3",
    "better-auth": "^1.6.26",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^6.0.5",
    "ioredis": "^6.0.0",
    "next": "15.5.10",
    "pg": "^8.22.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "13.5.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
