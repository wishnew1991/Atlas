# Server-only model configuration. Never expose these values with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
ATLAS_MODEL=gpt-4.1-mini

# Database (Prisma + SQLite). Swap to Postgres later by changing this URL.
DATABASE_URL="file:./dev.db"

# Clerk user authentication. Once configured, live model and MCP actions require a signed-in user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional server-side MCP gateway. The gateway accepts POST JSON:
# { "tool": "search" | "prepare_approval" | "execute_approved_action", "arguments": { ... } }
# and returns { "message": "...", "data": { ... } }.
ATLAS_MCP_GATEWAY_URL=
ATLAS_MCP_GATEWAY_TOKEN=

# parallel.ai web search MCP (https://search.parallel.ai/mcp).
# When set, Atlas seeds a global web-search tool so the assistant can search the web on any message.
PARALLEL_API_KEY=
PARALLEL_MCP_URL=https://search.parallel.ai/mcp

# Serper.dev web search (https://serper.dev). Optional — preferred over the MCP
# search when set. Can also be configured from the Admin → Search tab.
SERPER_API_KEY=

# NVIDIA API key — used for the NeMo omni voice model (speech-to-text and
# text-to-speech) and any nvidia-hosted chat model. Server-side only.
NVIDIA_API_KEY=
